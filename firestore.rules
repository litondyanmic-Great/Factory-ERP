rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : 'none';
    }

    function isActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'active';
    }

    function isAdmin() {
      return isActive() && myRole() == 'admin';
    }

    function hasRole(roles) {
      return isActive() && myRole() in roles;
    }

    // True if I'm admin, OR the given section key is in my assigned
    // sections list (users/{uid}.sections). Used to restrict production,
    // quality, yarn-store, winding, and accessories-store entries to only
    // the section(s) a staff member was granted in Admin > User Management.
    function mySections() {
      return ('sections' in myProfile()) ? myProfile().sections : [];
    }

    function canEnterSection(sectionKey) {
      return isActive() && (myRole() == 'admin' || sectionKey in mySections());
    }

    // --- Collection-group access -------------------------------------
    // Firestore requires a SEPARATE rule (beyond the nested subcollection
    // rule above) to permit collectionGroup() queries that read across
    // every style's subcollection at once. Without these, WindingQueue's
    // cross-style yarnLedger query and Dashboard's cross-style
    // productionEntries query silently fail with permission-denied.
    match /{path=**}/yarnLedger/{entryId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
    }
    match /{path=**}/accessoryLedger/{entryId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
    }
    match /{path=**}/productionEntries/{entryId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
    }

    // system/meta — a single doc used only to decide whether the very next
    // signup becomes the first admin. Any signed-in user may read it (the
    // signup transaction needs this); it may only ever flip from
    // "not initialized" to "initialized", never back.
    match /system/meta {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.initialized == true;
    }

    // settings/company — factory branding (name, logo, default language,
    // quality thresholds). Everyone signed in can read it (needed for the
    // login screen letterhead/logo); only an admin can change it.
    match /settings/company {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // defectTypes/{section} — per-section defect name list. Seed defects
    // ship in the app itself; this doc only holds custom defects someone
    // added on the floor for that section, so it must only ever be
    // extended by someone permitted to work in that section.
    match /defectTypes/{section} {
      allow read: if isSignedIn();
      allow create, update: if hasRole(['admin', 'production']) && canEnterSection(section);
      allow delete: if isAdmin();
    }

    // users/{uid} — profile holds role, department, status, sections.
    match /users/{uid} {
      allow read: if isSignedIn();

      // A user may only create their OWN profile document, exactly once,
      // at signup. It must start as 'pending' UNLESS system/meta is not yet
      // initialized, in which case it may be the bootstrap 'admin'.
      allow create: if isSignedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.department == null)
        ||
        (request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
          && request.resource.data.department == 'admin'
          && (!exists(/databases/$(database)/documents/system/meta)
              || get(/databases/$(database)/documents/system/meta).data.initialized != true))
      );

      // Only an admin can change someone's role/department/status/sections
      // (approving pending users, disabling accounts, assigning sections).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // styles/{styleId} — orders / production tracking.
    match /styles/{styleId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
      allow create, update: if hasRole(['admin', 'merchandising'])
        // also allow production-entry writes to the parent style's stage
        // counters (StyleDetail increments styles/{id}.stages.{stage}).
        || hasRole(['admin', 'production']);
      allow delete: if isAdmin();

      match /productionEntries/{entryId} {
        allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
        allow create: if hasRole(['admin', 'production']) && canEnterSection(request.resource.data.stage);
        allow update, delete: if isAdmin();
      }

      // Style-wise yarn ledger: dyeing order -> receipt (chalan) -> issue
      // to winding / direct-to-knitting -> winding-to-knitting -> knitting
      // consumption. Balances are always derived client-side from this
      // ledger, never stored, so deleting a wrong entry stays consistent.
      match /yarnLedger/{entryId} {
        allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
        allow create: if hasRole(['admin', 'store'])
          || canEnterSection('yarnStore')
          || canEnterSection('winding')
          || canEnterSection('knitting');
        // The Yarn Manager (store role) may update ONLY the `block` field
        // (A-M storage location) on an entry — everything else about a
        // ledger entry stays admin-only to edit.
        allow update: if isAdmin()
          || (hasRole(['admin', 'store']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['block']));
        allow delete: if isAdmin();
      }

      // Style-wise accessory ledger: receive against style (chalan/
      // supplier) -> issue to a specific production section.
      match /accessoryLedger/{entryId} {
        allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
        allow create: if hasRole(['admin', 'store']) || canEnterSection('accessoriesStore');
        allow update, delete: if isAdmin();
      }
    }

    // inventoryItems/{itemId} — yarn & accessories.
    match /inventoryItems/{itemId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
      allow create, update: if hasRole(['admin', 'store']);
      allow delete: if isAdmin();

      match /transactions/{txnId} {
        allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
        allow create: if hasRole(['admin', 'store']);
        allow update, delete: if isAdmin();
      }
    }

    // qualityChecks/{checkId} — daily QC entries per style + section
    // (+ block), used for the traffic-light dashboard, reports and trends.
    match /qualityChecks/{checkId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
      allow create: if hasRole(['admin', 'production']) && canEnterSection(request.resource.data.section);
      allow update, delete: if isAdmin();
    }

    // zeroThreadReports/{reportId} — factory-wide daily loose/uncut thread
    // checkpoint (one entry per date, editable), NOT tied to a style.
    match /zeroThreadReports/{reportId} {
      allow read: if hasRole(['admin', 'merchandising', 'production', 'store']);
      allow create, update: if hasRole(['admin', 'production']);
      allow delete: if isAdmin();
    }
  }
}
